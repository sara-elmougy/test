{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@tawakalna/services": ["../services/src/index.ts"],
      "@tawakalna/store": ["../store/src/index.ts"],
      "@tawakalna/interceptors": ["../interceptors/src/index.ts"],
      "@tawakalna/models": ["../models/src/index.ts"],
      "@tawakalna/environments": ["../environments/src/index.ts"],
      "@tawakalna/usecases": ["../usecases/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../usecases/tsconfig.lib.json"
    },
    {
      "path": "../store/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx"
  ]
}
