{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022",
      "DOM"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": [
      "@tawakalna/source"
    ],
    "paths": {
      "@libs": [
        "libs"
      ],
      "@assets": [
        "assets"
      ],
      "@twk-scripts": [
        "assets/scripts/twkhelper"
      ],
      "@tawakalna/services": [
        "libs/shared/services/src/index.ts"
      ]
    }
  }
}